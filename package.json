{
  "name": "agent-paulibaby",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/agents/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agent-paulibaby/web",
    "build": "npm run build --workspace=@agent-paulibaby/web",
    "deploy": "npm run deploy --workspace=@agent-paulibaby/gateway",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4",
    "@ai-sdk/react": "^4.0.174",
    "@cloudflare/ai-chat": "latest",
    "@cloudflare/codemode": "latest",
    "@cloudflare/computer": "latest",
    "@cloudflare/think": "latest",
    "@modelcontextprotocol/sdk": "^1",
    "agents": "latest",
    "ai": "^7.0.170",
    "just-bash": "^3.4.2",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5",
    "vite": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true,
    "core-js-pure@3.51.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
