{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-paulibaby",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  "ai": {
    "binding": "AI"
  },

  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },

  "durable_objects": {
    "bindings": [
      {
        "class_name": "PaulibabyAgent",
        "name": "PaulibabyAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PaulibabyAgent"]
    }
  ],

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  "mcp": {
    "servers": {
      "github": {
        "transport": {
          "type": "remote",
          "url": "https://api.githubcopilot.com/mcp/"
        },
        "auth": {
          "type": "bearer",
          "token": "YOUR_GITHUB_TOKEN"
        }
      }
    }
  }
}
