{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-paulibaby",
  "main": "apps/gateway/src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  "ai": {
    "binding": "AI"
  },

  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "assets": {
    "directory": "./apps/web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },

  "durable_objects": {
    "bindings": [
      {
        "class_name": "PaulibabyAgent",
        "name": "PaulibabyAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenCodeAgent"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "OpenCodeAgent",
          "to": "PaulibabyAgent"
        }
      ]
    }
  ],

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
